# MongoDB Configuration
MONGO_URL=mongodb://localhost:27017
DB_NAME=trading_signals

# Finnhub API (Market Data)
FINNHUB_API_KEY=your_finnhub_api_key_here

# Alpha Vantage API (Alternative Market Data)
ALPHAVANTAGE_API_KEY=your_alphavantage_key_here

# Pocket Option Integration
POCKET_OPTION_SSID=your_session_id_here
POCKET_OPTION_UID=your_user_id_here
POCKET_OPTION_ACCOUNT_ID=your_account_id_here
POCKET_OPTION_EMAIL=your_email@example.com
POCKET_OPTION_PASSWORD=your_password_here

# Bot Configuration
MIN_PROBABILITY_THRESHOLD=85
DEFAULT_STAKE=2.0
MAX_DAILY_TRADES=10
INVERT_SIGNALS=false

# Server Configuration
HOST=0.0.0.0
PORT=8001
DEBUG=True
LOG_LEVEL=INFO

# CORS (for local development)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
